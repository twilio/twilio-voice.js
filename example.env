# This env file is only needed for running integration tests
# Make a copy of this file with the name .env and populate the file with your environment variables
#
# There are two ways to supply access tokens to the integration tests:
#
#   1. Local minting (3rd-party contributors): leave VENDOR_URL unset and fill in
#      ACCOUNT_SID, API_KEY_SID, API_KEY_SECRET and APPLICATION_SID below. Tokens
#      are minted inside the Cypress Node process, so credentials never reach the
#      browser.
#
#   2. Credential vending (Twilio-internal and CI): set VENDOR_URL, plus
#      VENDOR_TOKEN when running outside of GitHub Actions. VENDOR_URL takes
#      precedence over the credentials below.

# Twilio account sid
ACCOUNT_SID=xxxxxxxxxxxxxxxx

# Twilio API key
API_KEY_SID=xxxxxxxxxxxxxxxx

# Twilio API secret
API_KEY_SECRET=xxxxxxxxxxxxxxxx

# "Integration Tests" TwiML App
APPLICATION_SID=xxxxxxxxxxxxxxxx

# "STIR/SHAKEN" TwiML App. Only needed by cypress/e2e/stirshaken.cy.ts
APPLICATION_SID_STIR=xxxxxxxxxxxxxxxx

# Twilio number the "STIR/SHAKEN" TwiML App dials as {{CallerId}}. Passed to the
# app on the access token, so it is also only needed by stirshaken.cy.ts
CALLER_ID=xxxxxxxxxxxxxxxx

# Twilio auth token. Only needed by the relay server (npm run test:relay-server)
AUTH_TOKEN=xxxxxxxxxxxxxxxx

# ngrok auth token, used by the relay server to open its tunnel
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxx

# Credential vending Function URL. Leave unset to mint tokens locally
# VENDOR_URL=

# Bearer token for VENDOR_URL, when not running in GitHub Actions
# VENDOR_TOKEN=
